# Copy this file to .env for local development: cp .env.example .env
# These values are for your own computer only. Never use them on a real server.

# Port the app listens on.
PORT=3000

# The app's database (started with: docker compose up -d).
DATABASE_URL=postgres://bill_splitter:local_dev_password@127.0.0.1:5432/bill_splitter

# Separate database used only by `npm test`. It is wiped on every test run.
TEST_DATABASE_URL=postgres://bill_splitter:local_dev_password@127.0.0.1:5432/bill_splitter_test

# Secret used to protect login sessions. On a server, set a long random value.
SESSION_SECRET=local-dev-secret-change-me-on-a-server
